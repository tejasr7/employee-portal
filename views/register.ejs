<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | Employee Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <div class="container">
      <div class="page-header">
        <h1>Employee Registration</h1>
        <p>Enter your details below. After registering, sign in with your email and password.</p>
      </div>

      <div class="card" style="max-width: 520px;">
        <% if (error) { %>
          <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/register">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Jane Smith" value="<%= values.name || '' %>" required>
          </div>

          <div class="form-group">
            <label for="email">Work Email</label>
            <input type="email" id="email" name="email" placeholder="jane@company.com" value="<%= values.email || '' %>" required>
          </div>

          <div class="form-group">
            <label for="dob">Date of Birth</label>
            <input type="date" id="dob" name="dob" value="<%= values.dob || '' %>" required>
          </div>

          <div class="form-group">
            <label for="department">Department</label>
            <select id="department" name="department" required>
              <option value="" disabled <%= !values.department ? 'selected' : '' %>>Select a department</option>
              <% departments.forEach(function(dept) { %>
                <option value="<%= dept %>" <%= values.department === dept ? 'selected' : '' %>><%= dept %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="At least 8 characters" minlength="8" required>
          </div>

          <div class="form-group">
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" minlength="8" required>
          </div>

          <button type="submit" class="btn btn-primary">Register</button>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
