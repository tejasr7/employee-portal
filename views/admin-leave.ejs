<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leave Balance | Employee Portal</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <div class="container">
      <div class="page-header">
        <h1>Leave Balance — <%= employee.name %></h1>
        <p>Set opening balance, additions, deductions, and LOP. The Balance is computed automatically.</p>
      </div>

      <% if (message) { %>
        <div class="alert alert-success"><%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (summary.banner) { %>
        <div class="alert alert-<%= summary.banner.type %>"><%= summary.banner.message %></div>
      <% } %>

      <div class="card" style="max-width: 640px;">
        <form method="POST" action="/admin/employees/<%= employee.id %>/leave">
          <div class="form-group">
            <label for="opening_balance">Opening Balance</label>
            <input type="number" step="0.5" id="opening_balance" name="opening_balance" value="<%= balance.opening_balance %>" required>
          </div>

          <div class="form-group">
            <label for="additions">Additions (credited this cycle)</label>
            <input type="number" step="0.5" id="additions" name="additions" value="<%= balance.additions %>" required>
          </div>

          <div class="form-group">
            <label for="deductions">Deductions (leaves taken)</label>
            <input type="number" step="0.5" id="deductions" name="deductions" value="<%= balance.deductions %>" required>
          </div>

          <div class="form-group">
            <label for="lop">Loss of Pay (LOP)</label>
            <input type="number" step="0.5" id="lop" name="lop" value="<%= balance.lop %>" required>
          </div>

          <div class="form-group">
            <label for="notes">Notes</label>
            <textarea id="notes" name="notes" rows="3"><%= balance.notes || '' %></textarea>
          </div>

          <div class="alert alert-info" style="font-size: 0.9rem;">
            Stored balance = Opening + Additions − Deductions. Negative balance is treated as LOP.
          </div>

          <div class="btn-group" style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary">Save Leave Balance</button>
            <a href="/admin/employees/<%= employee.id %>/status" class="btn btn-secondary">Edit Status</a>
            <a href="/admin" class="btn btn-secondary">Back to Dashboard</a>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>